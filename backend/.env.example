# Sao chép thành backend/.env rồi điền khoá Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# Model mặc định cho LLM Supervisor, trợ lý và báo cáo
STCS_LLM_MODEL=llama-3.3-70b-versatile
# Chế độ LLM Supervisor khi khởi động: OFF | ADVISORY | AUTONOMOUS
STCS_LLM_MODE=ADVISORY
# Chu kỳ phân tích định kỳ (giây) và timeout mỗi lần gọi
STCS_LLM_INTERVAL_S=60
STCS_LLM_TIMEOUT_S=8
